# Database (Postgres 15+ with the pgvector extension, e.g. Neon)
# Pooled connection used by the app at runtime
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/supportiq?sslmode=verify-full"
# Direct (non-pooled) connection used by Prisma migrations
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/supportiq?sslmode=verify-full"

# Session signing secret (any long random string: `openssl rand -base64 48`)
AUTH_SECRET="change-me"

# OpenRouter - get a key at https://openrouter.ai/keys
# Leave empty to run in offline demo mode (keyword search + extractive answers)
OPENROUTER_API_KEY=""
OPENROUTER_CHAT_MODEL="google/gemma-4-31b-it:free"
OPENROUTER_EMBED_MODEL="nvidia/nemotron-3.5-embed-1b:free"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seeded demo account
DEMO_EMAIL="demo@supportiq.dev"
DEMO_PASSWORD="demo-password-123"
